  "target_personas": [
    "Ecommerce beauty, skincare, fashion and lifestyle brand founders",
    "DTC brand owners",
    "Personal brand coaches and online fitness coaches",
    "Wellness brand founders",
    "Creator-focused businesses (NOT video production competitors)"
  ],

  "target_decision_maker": {
    "titles_to_target": ["Founder", "Co-founder", "Owner", "CEO", "Coach (solo business owner)"],
    "note": "Google Maps rarely lists a person. The decision maker's first name must come from the personal email (jane@brand.com) or the website's About/Team page via Firecrawl. No first name = RED."
  },

  "email_framework_preference": "EGO_BOOST or PAIN_POINT",
  "email_angle": "Reference their actual brand, product line or coaching offer from their website. Angle: brands like theirs live or die on short-form video (Reels, TikTok, product videos, ads) and most small teams can't produce enough of it. Never pitch generic 'video editing services'.",

  "filtering_rules": {
    "skip_generic_emails": ["info@", "marketing@", "support@", "hello@"],
    "skip_also_role_emails": ["contact@", "admin@", "noreply@", "no-reply@", "sales@", "team@", "office@", "enquiries@", "inquiries@", "help@", "careers@", "jobs@", "press@", "orders@", "customerservice@"],
    "skip_countries": ["Pakistan", "India", "Bangladesh"],
    "skip_competitors": {
      "rule": "Skip any video/film/production/editing/animation/content-production business — they are FASTECH competitors, not clients.",
      "category_or_name_keywords": ["video production", "video producer", "videographer", "videography", "film production", "production company", "production studio", "film studio", "video editing", "video agency", "animation studio", "post-production", "post production", "media production", "photo & video", "cinematography"]
    },
    "skip_if_no_website": true,
    "skip_if_no_first_name": true,
    "skip_if_large_corporation": true,
    "green_only_if": "Personal/direct email found (firstname@domain, name.surname@domain, or a personal Gmail/Outlook tied to the founder). Role emails in C4 are RED, not YELLOW."
  },

  "firecrawl": {
    "enabled": true,
    "extract_fields": [
      "founder / owner first name (About, Team, Our Story pages)",
      "personal email if published",
      "products or coaching offer",
      "current video / social content presence",
      "tone — casual founder or polished brand"
    ]
  }
